# Required — your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides (normally set in config.yml)
# HOST=0.0.0.0
# PORT=8080
# DATA_DIR=./data
# BASE_URL=http://localhost:8080

# Worker queue (shared with the Mac worker)
# WORKER_TOKEN=
# WORKER_MAX_UPLOAD_MB=500

# Admin API for /api/feeds + /api/episodes mutation endpoints.
# When unset, those endpoints return 503. Generate with:
#   openssl rand -hex 32
# ADMIN_TOKEN=
