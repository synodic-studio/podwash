# Settings for scripts/demo.sh. Copy to scripts/demo.env (gitignored) and
# set only what differs from these defaults.
#
#   cp scripts/demo.env.example scripts/demo.env

# Beat 1: the podwash server whose proxy feed gets fetched and measured.
# PODWASH_DEMO_SERVER=https://podcast.kj6.dev

# Beat 1: which proxy feed slug to pull.
# PODWASH_DEMO_FEED=the-daily

# Beats 2-3: an OpenAI-compatible /chat/completions root. Must end in /v1.
# PODWASH_DEMO_PROXY=http://localhost:4000/v1

# Beats 2-3: the model alias to route to. Keep this on the cheap tier -- a
# demo has no business spending on a big model, and on a 429 the script
# retries this same alias rather than escalating.
# PODWASH_DEMO_MODEL=small

# Bearer token, only if your proxy requires one. It is sent in an
# Authorization header and never printed. Leave empty for a local proxy.
# PODWASH_DEMO_KEY=
